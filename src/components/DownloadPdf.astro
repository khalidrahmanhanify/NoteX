---
import { Icon } from "astro-icon/components";
---

<button
  id="download-pdf"
  class="download-btn"
  type="button"
  aria-label="Save as PDF"
>
  <Icon name="download" class="btn-icon" />

  <span class="btn-text"> Save as PDF </span>
</button>

<script is:inline>
  (() => {
    const initializePDFButton = () => {
      const button = document.getElementById("download-pdf");

      if (!button) return;

      /*
       * Prevent duplicate event listeners.
       */
      if (button.dataset.initialized === "true") {
        return;
      }

      button.dataset.initialized = "true";

      button.addEventListener("click", () => {
        window.print();
      });
    };

    /*
     * Initial page load
     */
    initializePDFButton();

    /*
     * Astro View Transitions
     *
     * Runs whenever a new note page is
     * loaded through client-side navigation.
     */
    document.addEventListener("astro:page-load", initializePDFButton);
  })();
</script>

<style>
  .download-btn {
    position: fixed;
    z-index: 999;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    padding: 12px 24px;

    font-family:
      "Inter",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 15px;
    font-weight: 600;

    color: var(--text-primary);
    background: var(--card);

    border: 1px solid var(--accent);
    border-radius: 100px;

    cursor: pointer;

    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.3),
      0 8px 10px -6px rgba(0, 0, 0, 0.3);

    backdrop-filter: blur(10px);

    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .btn-icon {
    width: 18px;
    height: 18px;

    transition:
      transform 0.3s ease,
      color 0.3s ease;
  }

  /*
   * Desktop
   */

  @media (min-width: 768px) {
    .download-btn {
      right: 40px;
      bottom: 40px;
    }

    .download-btn:hover {
      background: var(--btn-hover, var(--card));

      transform: translateY(-4px) scale(1.02);

      border-color: var(--accent);

      box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.4);
    }

    .download-btn:hover .btn-icon {
      transform: translateY(2px);
      color: var(--accent);
    }
  }

  /*
   * Mobile
   */

  @media (max-width: 767px) {
    .download-btn {
      bottom: 24px;
      left: 50%;

      transform: translateX(-50%);

      width: 90%;
      max-width: 320px;

      padding: 16px;
    }

    .download-btn:active {
      transform: translateX(-50%) scale(0.96);

      background: var(--btn-hover, var(--card));
    }
  }

  /*
   * Hide when printing.
   */

  @media print {
    .download-btn {
      display: none !important;
    }
  }
</style>
