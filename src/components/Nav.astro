---
import "@/styles/global.css";
import { Icon } from "astro-icon/components";
---

<header>
  <div class="container">
    <div class="logo">
      <a href="/">NoteX</a>
    </div>

    <div class="theme-toggler">
      <button
        class="theme-toggle-desktop"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <div class="circle">
          <Icon name="sun" class="icon icon-sun" />

          <Icon name="moon" class="icon icon-moon" />
        </div>
      </button>
    </div>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--divider);

    position: fixed;
    top: 0;
    right: 0;
    left: 0;

    z-index: 999;

    background: var(--background);
  }

  header div.container {
    display: flex;
    justify-content: space-between;
    align-items: center;

    min-height: 60px;
    padding: 10px 0;
  }

  .logo {
    font-weight: bold;
    white-space: nowrap;
    font-size: 1.1rem;
  }

  .logo a {
    text-decoration: none;
    color: var(--text-primary);
  }

  .theme-toggle-desktop {
    width: 44px;
    height: 24px;

    position: relative;

    background-color: var(--card);

    border: 1px solid var(--divider);
    border-radius: 100px;

    cursor: pointer;

    padding: 0;

    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .theme-toggle-desktop .circle {
    position: absolute;

    top: 2px;
    left: 2px;

    width: 18px;
    height: 18px;

    background-color: var(--divider);

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.dark) .theme-toggle-desktop .circle {
    transform: translateX(20px);
  }

  .icon {
    width: 12px;
    height: 12px;
    color: var(--text-primary);
  }

  .icon-moon {
    display: none;
  }

  .icon-sun {
    display: block;
  }

  :global(.dark) .icon-sun {
    display: none;
  }

  :global(.dark) .icon-moon {
    display: block;
  }

  .theme-toggle-desktop:hover {
    border-color: var(--accent);
  }

  .theme-toggle-desktop:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>

<script is:inline>
  (() => {
    const setupThemeButton = () => {
      const button = document.querySelector(".theme-toggle-desktop");

      if (!button) return;

      /*
       * The button is replaced during navigation,
       * so mark each new button individually.
       */
      if (button.dataset.themeInitialized === "true") {
        return;
      }

      button.dataset.themeInitialized = "true";

      const updateButtonState = () => {
        const isDark = document.documentElement.classList.contains("dark");

        button.setAttribute("aria-pressed", String(isDark));

        button.setAttribute(
          "aria-label",
          isDark ? "Switch to light mode" : "Switch to dark mode",
        );
      };

      updateButtonState();

      button.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");

        localStorage.setItem("theme", isDark ? "dark" : "light");

        updateButtonState();
      });
    };

    /*
     * First page.
     */
    setupThemeButton();

    /*
     * New Nav button after every Astro navigation.
     */
    document.addEventListener("astro:page-load", setupThemeButton);
  })();
</script>
