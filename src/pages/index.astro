---
import BaseLayout from "@/components/BaseLayout.astro";
import { getCollection } from "astro:content";

const semesters = await getCollection("semesters");
---

<BaseLayout
  title="My University Notes"
  description="In this website I share all of my universitie's notes."
>
  <section class="container">
    <h1 class="page-heading">My University Notes</h1>
    <hr class="hr" />
    <h2 class="page-subheading">Semesters</h2>
    <div class="semester-cards">
      {
        semesters.map((semester) => (
          <a href={semester.data.url} class="semester-card">
            <div
              class="top-bar"
              style={`--bar-color: ${semester.data.barColor}`}
            />
            <div class="card-content">
              <h3 class="semester-name">{semester.data.semesterName}</h3>
              <div class="data-row">
                <div class="data-group">
                  <span class="label">Credits</span>
                  <span class="value">{semester.data.credits}</span>
                </div>
                <div class="data-group">
                  <span class="label">Total Fee</span>
                  <span class="value">
                    {(semester.data.credits * 2800 + 1000).toLocaleString() +
                      " AFN"}
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
<style>
  section.container {
    padding: 30px 0;
  }

  .semester-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 2rem;
  }

  .semester-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transform: translateY(0);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .semester-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow:
      0 6px 16px rgba(0, 0, 0, 0.08),
      0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .semester-card:active {
    transform: translateY(-1px);
  }

  .top-bar {
    height: 4px;
    width: 100%;
    background-color: var(--bar-color);
  }

  .semester-card .card-content {
    padding: 20px;
  }

  .semester-name {
    margin: 0 0 20px;
    padding-top: 4px;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--text-primary);
  }

  .data-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .data-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-size: 10px;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 1px;
  }

  .value {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Light mode */
  :global(:root) .semester-card {
    background: var(--card);
    border-color: var(--border);
  }

  :global(:root) .semester-card:hover {
    background: hsl(240, 6%, 99%);
    border-color: var(--accent);
  }

  /* Dark mode */
  :global(.dark) .semester-card {
    background: var(--card);
    border-color: var(--border);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.25),
      0 4px 12px rgba(0, 0, 0, 0.15);
  }

  :global(.dark) .semester-card:hover {
    background: hsl(231, 10%, 16%);
    border-color: var(--accent);
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.3),
      0 2px 6px rgba(0, 0, 0, 0.2);
  }

  /* Better keyboard accessibility */
  .semester-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Mobile */
  @media screen and (max-width: 640px) {
    .semester-cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .semester-card .card-content {
      padding: 18px;
    }

    .semester-name {
      font-size: 1.1rem;
    }
  }

  /* Disable hover movement on touch devices */
  @media (hover: none) {
    .semester-card:hover {
      transform: none;
      box-shadow: none;
    }

    .semester-card:active {
      transform: scale(0.99);
    }
  }
</style>
